{
  "description": "Human decisions: reviewer identity, reasons, separation of duties, terminal states",
  "steps": [
    {"tool": "assess", "args": {"signal_ids": ["SIG-014", "SIG-015", "SIG-016"]}, "save": {"asm": "assessment_id"}},
    {"tool": "propose_action", "args": {"assessment_id": "${asm}", "action": {"type": "reroute_shipment", "target": "lane VARDEN-TAMSK"}, "proposed_by": "dana.ops"}, "save": {"reroute": "action_id"},
     "expect": {"equals": {"status": "pending_approval", "risk": "high"}}},
    {"tool": "approve_action", "args": {"action_id": "${reroute}", "reviewer": "agent:triage", "reason": "looks right to me, the flood closure is confirmed"},
     "label": "automated identities cannot decide",
     "expect": {"error": "POLICY_DENIED", "error_contains": "automated identity"}},
    {"tool": "approve_action", "args": {"action_id": "${reroute}", "reviewer": "dana.ops", "reason": "flood closure confirmed by two feeds"},
     "label": "proposer cannot approve own high-risk action",
     "expect": {"error": "POLICY_DENIED", "error_contains": "proposer cannot approve"}},
    {"tool": "approve_action", "args": {"action_id": "${reroute}", "reviewer": "lee.supervisor", "reason": "ok"},
     "label": "high risk needs a substantive reason",
     "expect": {"error": "POLICY_DENIED", "error_contains": "at least 20 characters"}},
    {"tool": "approve_action", "args": {"action_id": "${reroute}", "reviewer": "lee.supervisor", "reason": ""},
     "label": "empty reason fails schema validation",
     "expect": {"error": "INVALID_INPUT"}},
    {"tool": "approve_action", "args": {"action_id": "${reroute}", "reviewer": "  lee.supervisor ", "reason": "  Flood closure confirmed by weather feed and telematics.  "},
     "label": "valid approval, inputs trimmed",
     "expect": {"equals": {"status": "approved", "decision.by": "lee.supervisor", "decision.reason": "Flood closure confirmed by weather feed and telematics.", "decision.at": "2026-03-02T09:00:06Z"}}},
    {"tool": "reject_action", "args": {"action_id": "${reroute}", "reviewer": "kim.audit", "reason": "too late"},
     "label": "decisions are terminal",
     "expect": {"error": "CONFLICT", "error_contains": "already approved"}},
    {"tool": "propose_action", "args": {"assessment_id": "${asm}", "action": {"type": "hold_shipment", "target": "trucks on river road"}, "proposed_by": "agent:triage"}, "save": {"hold": "action_id"}},
    {"tool": "reject_action", "args": {"action_id": "${hold}", "reviewer": "lee.supervisor", "reason": "no"},
     "label": "rejection needs only a non-empty reason",
     "expect": {"equals": {"status": "rejected", "decision.reason": "no"}}},
    {"tool": "reject_action", "args": {"action_id": "ACT-0404", "reviewer": "lee.supervisor", "reason": "n/a"},
     "label": "unknown action",
     "expect": {"error": "NOT_FOUND"}},
    {"tool": "list_actions", "args": {}, "label": "both actions listed in creation order",
     "expect": {"equals": {"actions.0.status": "approved", "actions.1.status": "rejected"}, "length": {"actions": 2}}}
  ]
}
